# Backend API env — copy to backend/.env (monorepo) or set in Coolify Environment
#   cp deploy/backend/.env.example backend/.env

# Required
OPENROUTER_API_KEY=
AUTH_SECRET=change-me-in-production

# Coolify: use the MongoDB resource hostname (NOT 127.0.0.1 / localhost).
# Example after linking a Coolify MongoDB service:
#   MONGODB_URI=mongodb://root:PASSWORD@UUID:27017/feynman?authSource=admin
MONGODB_URI=mongodb://127.0.0.1:27017/feynman

# Coolify → General → Ports Exposes must match this (default app port is 3141)
PORT=3141

FEYNMAN_MODEL=openrouter/openai/gpt-5.1
# FEYNMAN_OUTLINE_MODEL=openrouter/openai/gpt-5.1
# FEYNMAN_FAST_MODEL=openrouter/openai/gpt-4o-mini

# Optional: comma-separated browser origins (default reflects request Origin)
# CORS_ORIGIN=https://app.your.domain,https://your.domain

# DEFAULT_ADMIN_EMAIL=admin@aula.com
# DEFAULT_ADMIN_PASSWORD=admin123
# DEFAULT_ADMIN_NAME=Admin
# DEFAULT_ADMIN_ENABLED=true

# ALPHAXIV_ENABLED=true
# ALPHAXIV_API_KEY=
# TAVILY_ENABLED=true
# TAVILY_API_KEY=
# PAPER_LIBRARY_ENABLED=true
# PAPER_LIBRARY_MIN_HITS=4
