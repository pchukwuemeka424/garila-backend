# Backend API env — copy to backend/.env (monorepo) or set in Coolify Environment
#   cp deploy/backend/.env.example backend/.env

# Required
OPENROUTER_API_KEY=
AUTH_SECRET=change-me-in-production

# Public frontend origin for password-reset email links (no trailing slash)
# APP_URL=http://localhost:3000
# APP_URL=https://app.your.domain

# Optional: Resend for password-reset emails (without this, links are logged in the API console)
# RESEND_API_KEY=
# MAIL_FROM=Garil AI <noreply@your.domain>

# Coolify: use the MongoDB resource hostname (NOT 127.0.0.1 / localhost).
# Example after linking a Coolify MongoDB service:
#   MONGODB_URI=mongodb://root:PASSWORD@UUID:27017/feynman?authSource=admin
MONGODB_URI=mongodb://127.0.0.1:27017/feynman

# Coolify → General → Ports Exposes must match this (default app port is 3141)
PORT=3141

FEYNMAN_MODEL=openrouter/openai/gpt-5.1
# FEYNMAN_OUTLINE_MODEL=openrouter/openai/gpt-5.1
# FEYNMAN_FAST_MODEL=openrouter/openai/gpt-4o-mini

# Optional: comma-separated browser origins (default reflects request Origin)
# CORS_ORIGIN=https://app.your.domain,https://your.domain

# DEFAULT_ADMIN_EMAIL=admin@aula.com
# DEFAULT_ADMIN_PASSWORD=admin123
# DEFAULT_ADMIN_NAME=Admin
# DEFAULT_ADMIN_ENABLED=true

# Local seed only: password for demo students created by seed-okes-supervision.ts
# and seed-demo-supervision.ts (demo.lecturer@garilai.test).
# If unset, seed-demo-supervision.ts uses DemoStudent123!
# SEED_STUDENT_PASSWORD=

# ALPHAXIV_ENABLED=true
# ALPHAXIV_API_KEY=
# TAVILY_ENABLED=true
# TAVILY_API_KEY=
# HF_TOKEN=
# HUGGINGFACE_ENABLED=true
# HUGGINGFACE_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# HUGGINGFACE_NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
# OPENALEX_ENABLED=true
# OPENALEX_API_KEY=  # optional
# PUBMED_ENABLED=true
# PUBMED_API_KEY=  # optional
# NCBI_API_KEY=
# DOAJ_ENABLED=true
# DOAJ_API_BASE=https://doaj.org/api
# EUROPE_PMC_ENABLED=true
# EUROPE_PMC_API_BASE=https://www.ebi.ac.uk/europepmc/webservices/rest
# PAPER_LIBRARY_ENABLED=true
# PAPER_LIBRARY_MIN_HITS=4

# S3-compatible storage (MinIO). Optional — backend only; do not put these in frontend .env.
# Docs: deploy/minio/README.md
# S3_ENDPOINT=https://s3.garilai.com
# S3_REGION=us-east-1
# S3_BUCKET=garil
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=https://s3.garilai.com
# S3_MAX_UPLOAD_BYTES=2147483648
# S3_MAX_INLINE_BYTES=33554432
