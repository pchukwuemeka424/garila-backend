# Backend API env — copy to backend/.env (monorepo) or .env (standalone repo)
#   cp deploy/backend/.env.example backend/.env

OPENROUTER_API_KEY=
MONGODB_URI=mongodb://127.0.0.1:27017/feynman
PORT=3141
FEYNMAN_MODEL=openrouter/openai/gpt-5.1
# FEYNMAN_OUTLINE_MODEL=openrouter/openai/gpt-5.1
# FEYNMAN_FAST_MODEL=openrouter/openai/gpt-4o-mini
AUTH_SECRET=change-me-in-production

# Optional: comma-separated browser origins (default reflects request Origin)
# CORS_ORIGIN=https://app.your.domain,https://your.domain

